---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MusicologyNav from '../../components/MusicologyNav.astro';

const page = await getEntry('pages', 'musicology');
const { Content } = await render(page);
---

<Base title={page.data.title} heading={page.data.title} breadcrumb={[{ label: page.data.title }]}>
  <Content />
  <Fragment slot="sidebar">
    <MusicologyNav />
  </Fragment>
</Base>
